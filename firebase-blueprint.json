{
  "entities": {
    "User": {
      "title": "User",
      "description": "Akun pengguna sistem NutriMind AI (Siswa madrasah atau Petugas UKS)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "nameOrInitial": { "type": "string" },
        "role": { "type": "string", "enum": ["STUDENT", "UKS"] },
        "className": { "type": "string" },
        "age": { "type": "integer" },
        "gender": { "type": "string" },
        "studentIdNumber": { "type": "string" },
        "madrasahName": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "isProfileComplete": { "type": "boolean" },
        "agreedToTerms": { "type": "boolean" },
        "createdAt": { "type": "integer" },
        "lastLogin": { "type": "integer" }
      },
      "required": ["id", "email", "nameOrInitial", "role"]
    },
    "NutritionCheck": {
      "title": "NutritionCheck",
      "description": "Catatan skrining dan cek gizi mandiri siswa dari berbagai perangkat",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "age": { "type": "integer" },
        "gender": { "type": "string" },
        "weightKg": { "type": "number" },
        "heightCm": { "type": "number" },
        "bmi": { "type": "number" },
        "bmiCategory": { "type": "string" },
        "riskCategory": { "type": "string" },
        "breakfastHabit": { "type": "string" },
        "vegHabit": { "type": "string" },
        "fruitHabit": { "type": "string" },
        "fastFoodHabit": { "type": "string" },
        "sugaryDrinkHabit": { "type": "string" },
        "physicalActivity": { "type": "string" },
        "sedentaryDuration": { "type": "string" },
        "factorsToWatch": { "type": "string" },
        "generalAdvice": { "type": "string" },
        "dateString": { "type": "string" },
        "timestamp": { "type": "integer" }
      },
      "required": ["studentId", "studentName", "weightKg", "heightCm", "bmi", "bmiCategory", "riskCategory", "timestamp"]
    },
    "DailyCheck": {
      "title": "DailyCheck",
      "description": "Catatan kebiasaan harian gizi dan aktivitas siswa",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "dateString": { "type": "string" },
        "hadBreakfast": { "type": "boolean" },
        "mealCount": { "type": "integer" },
        "ateVegetable": { "type": "boolean" },
        "ateFruit": { "type": "boolean" },
        "sugaryDrinkCount": { "type": "string" },
        "didPhysicalActivity": { "type": "boolean" },
        "physicalActivityDuration": { "type": "string" },
        "sedentaryDuration": { "type": "string" },
        "sleepDuration": { "type": "string" },
        "bodyCondition": { "type": "string" },
        "summaryAdvice": { "type": "string" },
        "timestamp": { "type": "integer" }
      },
      "required": ["studentId", "dateString", "timestamp"]
    },
    "UksFollowUp": {
      "title": "UksFollowUp",
      "description": "Tindak lanjut dan catatan intervensi UKS untuk siswa",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "officerName": { "type": "string" },
        "note": { "type": "string" },
        "actionType": { "type": "string" },
        "dateString": { "type": "string" },
        "timestamp": { "type": "integer" }
      },
      "required": ["studentId", "officerName", "note", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Data profil siswa madrasah dan petugas UKS"
    },
    "/nutrition_checks/{checkId}": {
      "schema": "NutritionCheck",
      "description": "Koleksi data cek gizi siswa dari berbagai perangkat untuk disinkronkan ke Dashboard UKS"
    },
    "/daily_checks/{checkId}": {
      "schema": "DailyCheck",
      "description": "Koleksi catatan harian gizi siswa"
    },
    "/uks_follow_ups/{followUpId}": {
      "schema": "UksFollowUp",
      "description": "Catatan tindak lanjut petugas UKS"
    }
  }
}
